# Chael SIEM - Environment Configuration
# Copy this to .env and fill in your values

# --- Security (CHANGE THESE) ---
JWT_SECRET=change-this-to-a-random-64-char-string
ADMIN_PASSWORD=your-secure-admin-password

# --- OpenSearch ---
OPENSEARCH_HOSTS=["http://opensearch:9200"]
OPENSEARCH_PASSWORD=your-secure-opensearch-password

# --- Notification Channels (optional) ---
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- SMTP Email (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=siem@chael.local
ALERT_EMAIL_TO=

# --- Threat Intelligence (optional) ---
VT_API_KEY=
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=
OTX_API_KEY=
GREYNOISE_API_KEY=
IPINFO_API_KEY=

# --- Agent Configuration (optional) ---
CHAEL_SIEM_URL=https://gateway:8443
CHAEL_AGENT_ID=
CHAEL_AGENT_KEY=
LATEST_AGENT_VERSION=1.0.0

# --- Syslog Receiver (optional) ---
SYSLOG_ENABLED=false
SYSLOG_UDP_PORT=514
SYSLOG_TCP_PORT=514

# --- Correlation Tuning (optional) ---
# Override thresholds in config.yaml via environment
# Keep >= 10: single-user fat-fingers and scanners stay below it (no false positives)
BRUTE_FORCE_THRESHOLD=10
BRUTE_FORCE_WINDOW_SECONDS=300
REPEATED_ERROR_THRESHOLD=20
REPEATED_ERROR_WINDOW_SECONDS=600
DEDUP_WINDOW_SECONDS=3600

# --- AI Assistant (multi-provider BYOK, opt-in, privacy-first) ---
# Primary: OpenRouter (https://openrouter.ai/keys) — ONE key, many models.
#   Set OPENROUTER_MODELS comma-separated; a rate-limited (429) model auto-cools
#   and the call rotates to the next model/provider, then recovers on its own.
# Backup: Groq free tier (https://console.groq.com). Deterministic local fallback
#   is always available — the service works with NO key at all.
#   Verified live 2026-09-22 — use these models (llama-3.3-70b-versatile is
#   RETIRED by Groq and returns 404):
#   qwen/qwen3.8-27b (primary) / openai/gpt-oss-20b (backup) / groq/compound-mini (tool-using)
AI_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct,deepseek/deepseek-chat,qwen/qwen-2.5-72b-instruct
AI_PROVIDER_ORDER=groq,openrouter
AI_TIMEOUT_S=30
AI_KEY_COOLDOWN_S=300
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b,groq/compound-mini
GROQ_TIMEOUT_S=30
GROQ_MAX_TOKENS=1500
# Third provider: Google Gemini (OpenAI-compatible endpoint, generous free tier).
# Get a key at https://aistudio.google.com/apikey — joins the same auto-failover rotation.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash
GEMINI_TIMEOUT_S=30
GEMINI_MAX_TOKENS=1500

# --- Backup / Archiver ---
ARCHIVE_RETENTION_DAYS=30
ARCHIVE_SCHEDULE_CRON=0 2 * * *

# --- SOC digest reports (daily 08:00 + weekly Mon 09:00, via SMTP below) ---
# Needs SMTP_HOST + SMTP_TO to actually send; preview anytime via
# POST /api/backup/digest/daily {"send": false}
DIGEST_ENABLED=true
DIGEST_DAILY_CRON=0 8 * * *
DIGEST_WEEKLY_CRON=0 9 * * 1
SMTP_TO=
SMTP_TLS=true

# --- SOC role split (empty = disabled; see STATE.md USER ACTIONS) ---
# Approver: approves/rejects SOAR actions. Analyst: triggers + works incidents.
# ADMIN keeps both powers but can never approve its own triggers.
APPROVER_USERNAME=
APPROVER_PASSWORD=
ANALYST_USERNAME=
ANALYST_PASSWORD=
